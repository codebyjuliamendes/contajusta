# Copie para .env (não versionado) ou defina no ambiente de deploy.
PORT=3000
DATABASE_PATH=./data/contajusta.sqlite
LOG_LEVEL=info          # debug | info | warn | error | silent
TRUST_PROXY=0           # 1 atrás de um proxy reverso (Fly, Render, Nginx)
RATE_LIMIT_PER_MINUTE=60 # escritas por IP por minuto; 0 desativa
BACKUP_KEEP=14          # backups mantidos por `npm run backup`
